<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.INTERNET" />
<uses-feature android:name="android.software.leanback" android:required="false" />
<uses-feature android:name="android.hardware.touchscreen" android:required="false" />
<application android:label="LibreTV" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/app_icon" android:banner="@drawable/tv_banner" android:usesCleartextTraffic="true" android:allowBackup="false" android:supportsRtl="true">
<activity android:name=".MainActivity" android:icon="@drawable/app_icon" android:exported="true" android:screenOrientation="landscape"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter></activity>
<activity android:name=".PlaybackActivity" android:exported="false" android:screenOrientation="landscape"/>
</application></manifest>